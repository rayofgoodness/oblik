{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oblik-Rust",
  "version": "1.2.0",
  "identifier": "ua.shop.oblik.rust",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "rayofgoodness",
    "shortDescription": "Облік магазину",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Ukrainian"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
